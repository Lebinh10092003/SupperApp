{
  "name": "thcs-giang-vo-school-intelligence",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "npm --workspace apps/web run dev",
    "dev:api": "npm --workspace apps/api run dev",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm --workspace apps/api run test",
    "verify": "node scripts/verify-source.mjs",
    "check": "npm run verify && npm run typecheck && npm run test && npm run build"
  },
  "engines": {
    "node": ">=22 <25"
  },
  "dependencies": {
    "zod": "^3.24.2",
    "drizzle-orm": "0.44.6"
  }
}
