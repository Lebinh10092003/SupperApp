PROJECT_ID=thcs-giangvo
REGION=asia-southeast1
SCHOOL_ID=giang-vo
SCHOOL_NAME=Trường THCS Giảng Võ

# Super Admin Bootstrap (comma-separated emails / domains)
BOOTSTRAP_SUPER_ADMIN_EMAILS=09.levanbinh2003@gmail.com,admin@example.edu.vn
BOOTSTRAP_SUPER_ADMIN_DOMAINS=thcsgiangvo.edu.vn
BOOTSTRAP_ADMIN_EMAILS=admin@example.edu.vn

# Google OAuth 2.0 Credentials (Direct env or Secret Manager)
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/api/connections/oauth/callback

# Secret Manager Names (Production deployment)
CLASSROOM_OAUTH_CLIENT_ID_SECRET=si-classroom-oauth-client-id
CLASSROOM_OAUTH_CLIENT_SECRET_SECRET=si-classroom-oauth-client-secret
CLASSROOM_OAUTH_REFRESH_TOKEN_SECRET=si-classroom-oauth-refresh-token

# Google Workspace Domain-Wide Delegation (DWD - Mode B)
WORKSPACE_DOMAIN=example.edu.vn
WORKSPACE_ADMIN_SUBJECT=admin@example.edu.vn
DWD_SERVICE_ACCOUNT_EMAIL=si-workspace-dwd@thcs-giangvo.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=

# Organizational Units
TEACHER_OU_PREFIXES=/GiaoVien,/Teachers
STUDENT_OU_PREFIXES=/HocSinh,/Students

# Pub/Sub Push Configuration
CLASSROOM_TOPIC=projects/thcs-giangvo/topics/si-classroom-events
MEET_TOPIC=projects/thcs-giangvo/topics/si-meet-events
PUBSUB_PUSH_AUDIENCE=https://YOUR_API_URL
PUBSUB_PUSH_SERVICE_ACCOUNT=si-pubsub-push@thcs-giangvo.iam.gserviceaccount.com

# Server & Network
WEB_ORIGIN=http://localhost:5173
API_BASE_URL=http://localhost:8080
PORT=8080
