    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@google-cloud/firestore": "^9.0.1",
    "@google-cloud/secret-manager": "6.1.0",
    "cors": "2.8.5",
    "dotenv": "16.5.0",
    "drizzle-orm": "0.44.6",
    "pg": "8.23.0",
    "express": "5.1.0",
    "firebase-admin": "13.4.0",
    "google-auth-library": "9.15.1",
    "googleapis": "156.0.0",
    "pino": "9.7.0",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@types/cors": "2.8.17",
    "@types/express": "5.0.3",
    "@types/node": "22.15.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10",
    "tsx": "4.20.0",
    "typescript": "5.8.3"
  }
